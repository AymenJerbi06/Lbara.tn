# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lbara_db
DB_USER=postgres
DB_PASSWORD=your_db_password

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string_in_production
JWT_EXPIRES_IN=7d

# Encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=64_hex_characters_change_this_now

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="lbara.tn <hello@lbara.tn>"
EMAIL_VERIFICATION_REQUIRED=false
CONTACT_EMAIL_DELIVERY_ENABLED=false

# AI chat assistant (server-side only; never expose this in frontend code)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Flouci Payment Gateway
FLOUCI_APP_TOKEN=your_flouci_app_token
FLOUCI_APP_SECRET=your_flouci_app_secret
FLOUCI_DEVELOPER_ID=your_developer_id

# Paymee Payment Gateway
PAYMEE_API_KEY=your_paymee_api_key
PAYMEE_VENDOR_ID=your_paymee_vendor_id

# Admin
ADMIN_EMAIL=admin@lbara.tn
ADMIN_PASSWORD=change_this_admin_password

# Public account access
PUBLIC_AUTH_ENABLED=true

# Active Gateway: "flouci" or "paymee"
PAYMENT_GATEWAY=flouci

# Test-only escape hatch. Keep false/empty for any real public deployment.
ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=false

# Set true only when you want Railway to fail the deploy if production env vars are incomplete.
STRICT_RUNTIME_CONFIG=false
